{
  "name": "@interview-platform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit --pretty false && vite build --config vite.config.mjs --configLoader native",
